<?xml version="1.0" encoding="UTF-8"?>
<talendfile:ProcessType xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:TalendMapper="http://www.talend.org/mapper" xmlns:talendfile="platform:/resource/org.talend.model/model/TalendFile.xsd" defaultContext="Default" jobType="Standard">
  <context confirmationNeeded="false" name="Default">
    <contextParameter comment="Source host" name="src_db_host" prompt="src_db_host?" promptNeeded="false" type="id_String" value="db-source-prod.internal"/>
    <contextParameter comment="Period start" name="reporting_period_start" prompt="reporting_period_start?" promptNeeded="false" type="id_String" value="2024-01-01"/>
    <contextParameter comment="Period end" name="reporting_period_end" prompt="reporting_period_end?" promptNeeded="false" type="id_String" value="2024-03-31"/>
    <contextParameter comment="Output directory" name="output_dir" prompt="output_dir?" promptNeeded="false" type="id_String" value="/data/regulatory/cfpb/"/>
  </context>
  <parameters>
    <elementParameter field="TEXT" name="SCREEN_OFFSET_X" value="0" show="false"/>
    <elementParameter field="TEXT" name="SCREEN_OFFSET_Y" value="0" show="false"/>
    <elementParameter field="CHECK" name="MULTI_THREAD_EXECATION" value="false"/>
    <elementParameter field="CHECK" name="STATANDLOG_USE_PROJECT_SETTINGS" value="true" show="false"/>
    <routinesParameter id="_x0AbCdEfGh" name="DataOperation"/>
    <routinesParameter id="_x1AbCdEfGh" name="TalendDate"/>
    <routinesParameter id="_x2AbCdEfGh" name="AmountUtils"/>
    <routinesParameter id="_x3AbCdEfGh" name="DateFormatUtils"/>
  </parameters>
  <node componentName="tDBInput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="64">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBInput_1" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="ORACLE_12"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT la.APPLICATION_ID, la.CUSTOMER_ID, la.LOAN_TYPE, la.REQUESTED_AMOUNT, la.APPLICATION_DATE, la.STATUS, lr.DECISION, lr.RISK_SCORE FROM LOAN_APPLICATION la LEFT JOIN LOAN_RISK_SCORES lr ON la.APPLICATION_ID = lr.APPLICATION_ID WHERE la.APPLICATION_DATE BETWEEN TO_DATE(context.reporting_period_start, 'YYYY-MM-DD') AND TO_DATE(context.reporting_period_end, 'YYYY-MM-DD')&quot;"/>
    <elementParameter field="TEXT" name="LABEL" value="&quot;Loan Applications&quot;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tDBInput_1">
      <column comment="" key="true" length="20" name="APPLICATION_ID" nullable="false" sourceType="VARCHAR2" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="12" name="CUSTOMER_ID" nullable="false" sourceType="VARCHAR2" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="20" name="LOAN_TYPE" nullable="false" sourceType="VARCHAR2" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="15" name="REQUESTED_AMOUNT" nullable="false" sourceType="NUMBER" type="id_Double" usefulColumn="true"/>
      <column comment="" key="false" length="10" name="APPLICATION_DATE" nullable="false" pattern="&quot;yyyy-MM-dd&quot;" sourceType="DATE" type="id_Date" usefulColumn="true"/>
      <column comment="" key="false" length="20" name="STATUS" nullable="false" sourceType="VARCHAR2" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="20" name="DECISION" nullable="true" sourceType="VARCHAR2" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="10" name="RISK_SCORE" nullable="true" sourceType="NUMBER" type="id_Integer" usefulColumn="true"/>
    </metadata>
  </node>
  <node componentName="tDBInput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="160">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBInput_2" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="ORACLE_12"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT CUSTOMER_ID, STATE_CODE, ZIP_CODE, CREDIT_SCORE, ANNUAL_INCOME, DATE_OF_BIRTH FROM CUSTOMER_MASTER&quot;"/>
    <elementParameter field="TEXT" name="LABEL" value="&quot;Customer Demographics&quot;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tDBInput_2">
      <column comment="" key="true" length="12" name="CUSTOMER_ID" nullable="false" sourceType="VARCHAR2" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="2" name="STATE_CODE" nullable="true" sourceType="VARCHAR2" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="10" name="ZIP_CODE" nullable="true" sourceType="VARCHAR2" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="5" name="CREDIT_SCORE" nullable="true" sourceType="NUMBER" type="id_Integer" usefulColumn="true"/>
      <column comment="" key="false" length="15" name="ANNUAL_INCOME" nullable="true" sourceType="NUMBER" type="id_Double" usefulColumn="true"/>
      <column comment="" key="false" length="10" name="DATE_OF_BIRTH" nullable="true" pattern="&quot;yyyy-MM-dd&quot;" sourceType="DATE" type="id_Date" usefulColumn="true"/>
    </metadata>
  </node>
  <node componentName="tDBInput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="256">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBInput_3" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="ORACLE_12"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT APPLICATION_ID, ADVERSE_ACTION_CODE, ADVERSE_ACTION_DATE, NOTICE_SENT FROM ADVERSE_ACTIONS WHERE ADVERSE_ACTION_DATE BETWEEN TO_DATE(context.reporting_period_start, 'YYYY-MM-DD') AND TO_DATE(context.reporting_period_end, 'YYYY-MM-DD')&quot;"/>
    <elementParameter field="TEXT" name="LABEL" value="&quot;Adverse Actions&quot;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tDBInput_3">
      <column comment="" key="true" length="20" name="APPLICATION_ID" nullable="false" sourceType="VARCHAR2" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="10" name="ADVERSE_ACTION_CODE" nullable="false" sourceType="VARCHAR2" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="10" name="ADVERSE_ACTION_DATE" nullable="false" pattern="&quot;yyyy-MM-dd&quot;" sourceType="DATE" type="id_Date" usefulColumn="true"/>
      <column comment="" key="false" length="1" name="NOTICE_SENT" nullable="false" sourceType="CHAR" type="id_String" usefulColumn="true"/>
    </metadata>
  </node>
  <node componentName="tMap" componentVersion="2.1" offsetLabelX="0" offsetLabelY="0" posX="352" posY="128">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMap_1" show="false"/>
    <elementParameter field="EXTERNAL" name="MAP" value=""/>
    <elementParameter field="TEXT" name="ROWS_BUFFER_SIZE" value="2000000"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="cfpb_record">
      <column comment="" key="false" length="20" name="APPLICATION_ID" nullable="false" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="20" name="LOAN_TYPE" nullable="false" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="15" name="REQUESTED_AMOUNT" nullable="false" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="10" name="APPLICATION_DATE" nullable="false" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="20" name="ACTION_TAKEN" nullable="false" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="2" name="STATE_CODE" nullable="true" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="3" name="CENSUS_TRACT" nullable="true" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="20" name="INCOME_BRACKET" nullable="true" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="10" name="REPORT_PERIOD" nullable="false" type="id_String" usefulColumn="true"/>
    </metadata>
    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties shellMaximized="true"/>
      <varTables sizeState="INTERMEDIATE" name="Var" minimized="false">
        <mapperTableEntries name="actionTaken" expression="row3.ADVERSE_ACTION_CODE != null ? &quot;DENIED&quot; : (row1.DECISION != null ? row1.DECISION : row1.STATUS)" type="id_String" nullable="false"/>
        <mapperTableEntries name="incomeBracket" expression="row2.ANNUAL_INCOME != null ? (row2.ANNUAL_INCOME &lt; 50000 ? &quot;LOW&quot; : (row2.ANNUAL_INCOME &lt; 100000 ? &quot;MEDIUM&quot; : &quot;HIGH&quot;)) : &quot;NOT_REPORTED&quot;" type="id_String" nullable="true"/>
      </varTables>
      <outputTables sizeState="INTERMEDIATE" name="cfpb_record">
        <mapperTableEntries name="APPLICATION_ID" expression="row1.APPLICATION_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="LOAN_TYPE" expression="row1.LOAN_TYPE" type="id_String" nullable="false"/>
        <mapperTableEntries name="REQUESTED_AMOUNT" expression="AmountUtils.formatCurrency(row1.REQUESTED_AMOUNT)" type="id_String" nullable="false"/>
        <mapperTableEntries name="APPLICATION_DATE" expression="DateFormatUtils.formatDate(row1.APPLICATION_DATE, &quot;MM/dd/yyyy&quot;)" type="id_String" nullable="false"/>
        <mapperTableEntries name="ACTION_TAKEN" expression="Var.actionTaken" type="id_String" nullable="false"/>
        <mapperTableEntries name="STATE_CODE" expression="row2.STATE_CODE" type="id_String" nullable="true"/>
        <mapperTableEntries name="CENSUS_TRACT" expression="row2.ZIP_CODE != null ? row2.ZIP_CODE.substring(0, 3) : null" type="id_String" nullable="true"/>
        <mapperTableEntries name="INCOME_BRACKET" expression="Var.incomeBracket" type="id_String" nullable="true"/>
        <mapperTableEntries name="REPORT_PERIOD" expression="context.reporting_period_start + &quot; to &quot; + context.reporting_period_end" type="id_String" nullable="false"/>
      </outputTables>
      <inputTables sizeState="INTERMEDIATE" name="row1" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="APPLICATION_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="CUSTOMER_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="LOAN_TYPE" type="id_String" nullable="false"/>
        <mapperTableEntries name="REQUESTED_AMOUNT" type="id_Double" nullable="false"/>
        <mapperTableEntries name="APPLICATION_DATE" type="id_Date" nullable="false"/>
        <mapperTableEntries name="STATUS" type="id_String" nullable="false"/>
        <mapperTableEntries name="DECISION" type="id_String" nullable="true"/>
        <mapperTableEntries name="RISK_SCORE" type="id_Integer" nullable="true"/>
      </inputTables>
      <inputTables sizeState="INTERMEDIATE" name="row2" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE" joinModel="LEFT_OUTER_JOIN" joinExpressionKey="row1.CUSTOMER_ID" joinExpression="row2.CUSTOMER_ID">
        <mapperTableEntries name="CUSTOMER_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="STATE_CODE" type="id_String" nullable="true"/>
        <mapperTableEntries name="ZIP_CODE" type="id_String" nullable="true"/>
        <mapperTableEntries name="CREDIT_SCORE" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="ANNUAL_INCOME" type="id_Double" nullable="true"/>
        <mapperTableEntries name="DATE_OF_BIRTH" type="id_Date" nullable="true"/>
      </inputTables>
      <inputTables sizeState="INTERMEDIATE" name="row3" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE" joinModel="LEFT_OUTER_JOIN" joinExpressionKey="row1.APPLICATION_ID" joinExpression="row3.APPLICATION_ID">
        <mapperTableEntries name="APPLICATION_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="ADVERSE_ACTION_CODE" type="id_String" nullable="false"/>
        <mapperTableEntries name="ADVERSE_ACTION_DATE" type="id_Date" nullable="false"/>
        <mapperTableEntries name="NOTICE_SENT" type="id_String" nullable="false"/>
      </inputTables>
    </nodeData>
  </node>
  <node componentName="tFileOutputDelimited" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="576" posY="128">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tFileOutputDelimited_1" show="false"/>
    <elementParameter field="FILE" name="FILENAME" value="context.output_dir + &quot;cfpb_hmda_&quot; + context.reporting_period_end + &quot;.csv&quot;"/>
    <elementParameter field="TEXT" name="FIELDSEPARATOR" value="&quot;|&quot;"/>
    <elementParameter field="CHECK" name="INCLUDEHEADER" value="true"/>
    <elementParameter field="ENCODING_TYPE" name="ENCODING" value="&quot;UTF-8&quot;"/>
    <elementParameter field="TEXT" name="LABEL" value="&quot;CFPB HMDA File&quot;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <connection connectorName="FLOW" label="row1" lineStyle="0" metaname="tDBInput_1" offsetLabelX="0" offsetLabelY="0" source="tDBInput_1" target="tMap_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="row1" show="false"/>
  </connection>
  <connection connectorName="FLOW" label="row2" lineStyle="0" metaname="tDBInput_2" offsetLabelX="0" offsetLabelY="0" source="tDBInput_2" target="tMap_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="row2" show="false"/>
  </connection>
  <connection connectorName="FLOW" label="row3" lineStyle="0" metaname="tDBInput_3" offsetLabelX="0" offsetLabelY="0" source="tDBInput_3" target="tMap_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="row3" show="false"/>
  </connection>
  <connection connectorName="FLOW" label="cfpb_record" lineStyle="0" metaname="cfpb_record" offsetLabelX="0" offsetLabelY="0" source="tMap_1" target="tFileOutputDelimited_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="cfpb_record" show="false"/>
  </connection>
  <subjob>
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBInput_1" show="false"/>
    <elementParameter field="COLOR" name="SUBJOB_TITLE_COLOR" value="92;131;150" show="false"/>
    <elementParameter field="COLOR" name="SUBJOB_COLOR" value="207;226;236"/>
  </subjob>
</talendfile:ProcessType>
