<?xml version="1.0" encoding="UTF-8"?>
<talendfile:ProcessType xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:TalendMapper="http://www.talend.org/mapper" xmlns:talendfile="platform:/resource/org.talend.model/model/TalendFile.xsd" defaultContext="Default" jobType="Standard">
  <context confirmationNeeded="false" name="Default">
    <contextParameter comment="Source host" name="src_db_host" prompt="src_db_host?" promptNeeded="false" type="id_String" value="db-source-prod.internal"/>
    <contextParameter comment="Settlement date" name="settlement_date" prompt="settlement_date?" promptNeeded="false" type="id_String" value=""/>
    <contextParameter comment="Auto-settle limit" name="auto_settle_threshold" prompt="auto_settle_threshold?" promptNeeded="false" type="id_Double" value="5000.00"/>
  </context>
  <parameters>
    <elementParameter field="TEXT" name="SCREEN_OFFSET_X" value="0" show="false"/>
    <elementParameter field="TEXT" name="SCREEN_OFFSET_Y" value="0" show="false"/>
    <elementParameter field="CHECK" name="MULTI_THREAD_EXECATION" value="false"/>
    <elementParameter field="CHECK" name="STATANDLOG_USE_PROJECT_SETTINGS" value="true" show="false"/>
    <routinesParameter id="_x0AbCdEfGh" name="DataOperation"/>
    <routinesParameter id="_x1AbCdEfGh" name="TalendDate"/>
    <routinesParameter id="_x2AbCdEfGh" name="AmountUtils"/>
  </parameters>
  <node componentName="tDBInput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="96" posY="96">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBInput_1" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="SNOWFLAKE"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT pr.PAYMENT_ID, pr.LOAN_ID, pr.CUSTOMER_ID, pr.PAYMENT_AMOUNT, pr.AMOUNT_DUE, pr.VARIANCE, pr.MATCH_STATUS FROM PAYMENT_RECONCILIATION pr WHERE pr.MATCH_STATUS = 'MATCHED' AND pr.SETTLEMENT_STATUS IS NULL&quot;"/>
    <elementParameter field="TEXT" name="LABEL" value="&quot;Matched Unsettled&quot;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tDBInput_1">
      <column comment="" key="true" length="20" name="PAYMENT_ID" nullable="false" sourceType="VARCHAR" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="20" name="LOAN_ID" nullable="false" sourceType="VARCHAR" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="12" name="CUSTOMER_ID" nullable="false" sourceType="VARCHAR" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="15" name="PAYMENT_AMOUNT" nullable="false" sourceType="NUMBER" type="id_Double" usefulColumn="true"/>
      <column comment="" key="false" length="15" name="AMOUNT_DUE" nullable="false" sourceType="NUMBER" type="id_Double" usefulColumn="true"/>
      <column comment="" key="false" length="15" name="VARIANCE" nullable="false" sourceType="NUMBER" type="id_Double" usefulColumn="true"/>
      <column comment="" key="false" length="15" name="MATCH_STATUS" nullable="false" sourceType="VARCHAR" type="id_String" usefulColumn="true"/>
    </metadata>
  </node>
  <node componentName="tMap" componentVersion="2.1" offsetLabelX="0" offsetLabelY="0" posX="320" posY="96">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMap_1" show="false"/>
    <elementParameter field="EXTERNAL" name="MAP" value=""/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="settlement_output">
      <column comment="" key="true" length="20" name="PAYMENT_ID" nullable="false" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="20" name="LOAN_ID" nullable="false" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="15" name="SETTLEMENT_AMOUNT" nullable="false" type="id_Double" usefulColumn="true"/>
      <column comment="" key="false" length="20" name="SETTLEMENT_TYPE" nullable="false" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="19" name="SETTLED_AT" nullable="false" pattern="&quot;yyyy-MM-dd HH:mm:ss&quot;" type="id_Date" usefulColumn="true"/>
    </metadata>
    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties shellMaximized="true"/>
      <varTables sizeState="INTERMEDIATE" name="Var" minimized="true"/>
      <outputTables sizeState="INTERMEDIATE" name="settlement_output">
        <mapperTableEntries name="PAYMENT_ID" expression="row1.PAYMENT_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="LOAN_ID" expression="row1.LOAN_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="SETTLEMENT_AMOUNT" expression="AmountUtils.roundToDecimal(row1.PAYMENT_AMOUNT, 2)" type="id_Double" nullable="false"/>
        <mapperTableEntries name="SETTLEMENT_TYPE" expression="row1.PAYMENT_AMOUNT &lt;= context.auto_settle_threshold ? &quot;AUTO&quot; : &quot;MANUAL_REVIEW&quot;" type="id_String" nullable="false"/>
        <mapperTableEntries name="SETTLED_AT" expression="TalendDate.getCurrentDate()" type="id_Date" nullable="false"/>
      </outputTables>
      <inputTables sizeState="INTERMEDIATE" name="row1" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="PAYMENT_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="LOAN_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="CUSTOMER_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="PAYMENT_AMOUNT" type="id_Double" nullable="false"/>
        <mapperTableEntries name="AMOUNT_DUE" type="id_Double" nullable="false"/>
        <mapperTableEntries name="VARIANCE" type="id_Double" nullable="false"/>
        <mapperTableEntries name="MATCH_STATUS" type="id_String" nullable="false"/>
      </inputTables>
    </nodeData>
  </node>
  <node componentName="tDBOutput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="544" posY="64">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBOutput_1" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="SNOWFLAKE"/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;PAYMENT_SETTLEMENT&quot;"/>
    <elementParameter field="CLOSED_LIST" name="DATA_ACTION" value="INSERT"/>
    <elementParameter field="TEXT" name="LABEL" value="&quot;Settlement Records&quot;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tDBRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="544" posY="160">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBRow_1" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="ORACLE_12"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;UPDATE INCOMING_PAYMENTS SET RECONCILED = 'Y', RECONCILED_DATE = SYSDATE WHERE PAYMENT_ID = '&quot; + row1.PAYMENT_ID + &quot;'&quot;"/>
    <elementParameter field="TEXT" name="LABEL" value="&quot;Mark Reconciled&quot;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <connection connectorName="FLOW" label="row1" lineStyle="0" metaname="tDBInput_1" offsetLabelX="0" offsetLabelY="0" source="tDBInput_1" target="tMap_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="row1" show="false"/>
  </connection>
  <connection connectorName="FLOW" label="settlement_output" lineStyle="0" metaname="settlement_output" offsetLabelX="0" offsetLabelY="0" source="tMap_1" target="tDBOutput_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="settlement_output" show="false"/>
  </connection>
  <connection connectorName="FLOW" label="row3" lineStyle="0" metaname="settlement_output" offsetLabelX="0" offsetLabelY="0" source="tMap_1" target="tDBRow_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="row3" show="false"/>
  </connection>
  <subjob>
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBInput_1" show="false"/>
    <elementParameter field="COLOR" name="SUBJOB_TITLE_COLOR" value="92;131;150" show="false"/>
    <elementParameter field="COLOR" name="SUBJOB_COLOR" value="207;226;236"/>
  </subjob>
</talendfile:ProcessType>
