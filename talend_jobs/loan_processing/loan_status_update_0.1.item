<?xml version="1.0" encoding="UTF-8"?>
<talendfile:ProcessType xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:talendfile="platform:/resource/org.talend.model/model/TalendFile.xsd" defaultContext="Default" jobType="Standard">
  <context confirmationNeeded="false" name="Default">
    <contextParameter comment="Source database host" name="src_db_host" prompt="src_db_host?" promptNeeded="false" type="id_String" value="db-source-prod.internal"/>
    <contextParameter comment="Batch date" name="batch_date" prompt="batch_date?" promptNeeded="false" type="id_String" value=""/>
  </context>
  <parameters>
    <elementParameter field="TEXT" name="SCREEN_OFFSET_X" value="0" show="false"/>
    <elementParameter field="TEXT" name="SCREEN_OFFSET_Y" value="0" show="false"/>
    <elementParameter field="CHECK" name="MULTI_THREAD_EXECATION" value="false"/>
    <elementParameter field="CHECK" name="STATANDLOG_USE_PROJECT_SETTINGS" value="true" show="false"/>
    <routinesParameter id="_sU1aBcDeFg" name="DataOperation"/>
    <routinesParameter id="_sU2aBcDeFg" name="TalendDate"/>
  </parameters>
  <node componentName="tDBInput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="96" posY="96">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBInput_1" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="SNOWFLAKE"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT APPLICATION_ID, CUSTOMER_ID, DECISION, RISK_SCORE, SCORED_AT FROM LOAN_RISK_SCORES WHERE SCORED_AT >= DATEADD(day, -1, CURRENT_DATE())&quot;"/>
    <elementParameter field="TEXT" name="LABEL" value="&quot;Recent Risk Scores&quot;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tDBInput_1">
      <column comment="" key="true" length="20" name="APPLICATION_ID" nullable="false" sourceType="VARCHAR" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="12" name="CUSTOMER_ID" nullable="false" sourceType="VARCHAR" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="20" name="DECISION" nullable="false" sourceType="VARCHAR" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="10" name="RISK_SCORE" nullable="false" sourceType="NUMBER" type="id_Integer" usefulColumn="true"/>
      <column comment="" key="false" length="19" name="SCORED_AT" nullable="false" pattern="&quot;yyyy-MM-dd HH:mm:ss&quot;" sourceType="TIMESTAMP" type="id_Date" usefulColumn="true"/>
    </metadata>
  </node>
  <node componentName="tDBRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="320" posY="96">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBRow_1" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="ORACLE_12"/>
    <elementParameter field="TEXT" name="HOST" value="context.src_db_host"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;UPDATE LOAN_APPLICATION SET STATUS = '&quot; + row1.DECISION + &quot;', RISK_SCORE = &quot; + row1.RISK_SCORE + &quot;, LAST_UPDATED = SYSDATE WHERE APPLICATION_ID = '&quot; + row1.APPLICATION_ID + &quot;'&quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="&quot;Update Source Status&quot;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tLogRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="544" posY="96">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tLogRow_1" show="false"/>
    <elementParameter field="RADIO" name="TABLE_PRINT" value="true"/>
    <elementParameter field="CHECK" name="PRINT_HEADER" value="true"/>
    <elementParameter field="CHECK" name="PRINT_CONTENT_WITH_LOG4J" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="&quot;Log Updates&quot;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <connection connectorName="FLOW" label="row1" lineStyle="0" metaname="tDBInput_1" offsetLabelX="0" offsetLabelY="0" source="tDBInput_1" target="tDBRow_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="row1" show="false"/>
  </connection>
  <connection connectorName="FLOW" label="row2" lineStyle="0" metaname="tDBInput_1" offsetLabelX="0" offsetLabelY="0" source="tDBRow_1" target="tLogRow_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="row2" show="false"/>
  </connection>
  <subjob>
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBInput_1" show="false"/>
    <elementParameter field="COLOR" name="SUBJOB_TITLE_COLOR" value="92;131;150" show="false"/>
    <elementParameter field="COLOR" name="SUBJOB_COLOR" value="207;226;236"/>
  </subjob>
</talendfile:ProcessType>
