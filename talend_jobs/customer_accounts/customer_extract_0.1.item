    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties shellMaximized="true"/>
      <varTables sizeState="INTERMEDIATE" name="Var" minimized="true"/>
      <outputTables sizeState="INTERMEDIATE" name="out_customer">
        <mapperTableEntries name="CUSTOMER_ID" expression="row1.CUSTOMER_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="FULL_NAME" expression="row1.FIRST_NAME + &quot; &quot; + row1.LAST_NAME" type="id_String" nullable="false"/>
        <mapperTableEntries name="SSN_MASKED" expression="&quot;***-**-&quot; + row1.SSN.substring(7)" type="id_String" nullable="true"/>
        <mapperTableEntries name="DATE_OF_BIRTH" expression="row1.DATE_OF_BIRTH" type="id_Date" nullable="true"/>
        <mapperTableEntries name="EMAIL" expression="row1.EMAIL != null ? row1.EMAIL.toLowerCase() : null" type="id_String" nullable="true"/>
        <mapperTableEntries name="PHONE_PRIMARY" expression="row1.PHONE_PRIMARY" type="id_String" nullable="true"/>
        <mapperTableEntries name="FULL_ADDRESS" expression="row1.ADDRESS_LINE1 + (row1.ADDRESS_LINE2 != null ? &quot; &quot; + row1.ADDRESS_LINE2 : &quot;&quot;) + &quot;, &quot; + row1.CITY + &quot;, &quot; + row1.STATE_CODE + &quot; &quot; + row1.ZIP_CODE" type="id_String" nullable="true"/>
        <mapperTableEntries name="ACCOUNT_STATUS" expression="row1.ACCOUNT_STATUS" type="id_String" nullable="false"/>
        <mapperTableEntries name="CREDIT_SCORE" expression="row1.CREDIT_SCORE" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="CUSTOMER_SINCE" expression="row1.CUSTOMER_SINCE" type="id_Date" nullable="true"/>
        <mapperTableEntries name="ETL_LOAD_TS" expression="TalendDate.getCurrentDate()" type="id_Date" nullable="false"/>
      </outputTables>
      <inputTables sizeState="INTERMEDIATE" name="row1" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="CUSTOMER_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="FIRST_NAME" type="id_String" nullable="false"/>
        <mapperTableEntries name="LAST_NAME" type="id_String" nullable="false"/>
        <mapperTableEntries name="SSN" type="id_String" nullable="true"/>
        <mapperTableEntries name="DATE_OF_BIRTH" type="id_Date" nullable="true"/>
        <mapperTableEntries name="EMAIL" type="id_String" nullable="true"/>
        <mapperTableEntries name="PHONE_PRIMARY" type="id_String" nullable="true"/>
        <mapperTableEntries name="ADDRESS_LINE1" type="id_String" nullable="true"/>
        <mapperTableEntries name="ADDRESS_LINE2" type="id_String" nullable="true"/>
        <mapperTableEntries name="CITY" type="id_String" nullable="true"/>
        <mapperTableEntries name="STATE_CODE" type="id_String" nullable="true"/>
        <mapperTableEntries name="ZIP_CODE" type="id_String" nullable="true"/>
        <mapperTableEntries name="ACCOUNT_STATUS" type="id_String" nullable="false"/>
        <mapperTableEntries name="CREDIT_SCORE" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="CUSTOMER_SINCE" type="id_Date" nullable="true"/>
        <mapperTableEntries name="LAST_UPDATED" type="id_Date" nullable="true"/>
      </inputTables>
    </nodeData>
