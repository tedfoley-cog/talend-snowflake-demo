<?xml version="1.0" encoding="UTF-8"?>
<talendfile:ProcessType xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:TalendMapper="http://www.talend.org/mapper" xmlns:talendfile="platform:/resource/org.talend.model/model/TalendFile.xsd" defaultContext="Default" jobType="Standard">
  <context confirmationNeeded="false" name="Default">
    <contextParameter comment="Input directory" name="input_dir" prompt="input_dir?" promptNeeded="false" type="id_String" value="/data/incoming/address_updates/"/>
    <contextParameter comment="Target schema" name="tgt_schema" prompt="tgt_schema?" promptNeeded="false" type="id_String" value="RAW"/>
  </context>
  <parameters>
    <elementParameter field="TEXT" name="SCREEN_OFFSET_X" value="0" show="false"/>
    <elementParameter field="TEXT" name="SCREEN_OFFSET_Y" value="0" show="false"/>
    <elementParameter field="CHECK" name="MULTI_THREAD_EXECATION" value="false"/>
    <elementParameter field="CHECK" name="STATANDLOG_USE_PROJECT_SETTINGS" value="true" show="false"/>
    <routinesParameter id="_x0AbCdEfGh" name="DataOperation"/>
    <routinesParameter id="_x1AbCdEfGh" name="StringHandling"/>
    <routinesParameter id="_x2AbCdEfGh" name="TalendDate"/>
  </parameters>
  <node componentName="tFileInputDelimited" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="96" posY="96">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tFileInputDelimited_1" show="false"/>
    <elementParameter field="FILE" name="FILENAME" value="context.input_dir + &quot;address_corrections.csv&quot;"/>
    <elementParameter field="TEXT" name="FIELDSEPARATOR" value="&quot;,&quot;"/>
    <elementParameter field="CHECK" name="CSV_OPTION" value="true"/>
    <elementParameter field="TEXT" name="HEADER" value="1"/>
    <elementParameter field="CHECK" name="REMOVE_EMPTY_ROW" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="&quot;Address Corrections&quot;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tFileInputDelimited_1">
      <column comment="" key="true" length="12" name="CUSTOMER_ID" nullable="false" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="100" name="ADDRESS_LINE1" nullable="true" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="100" name="ADDRESS_LINE2" nullable="true" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="50" name="CITY" nullable="true" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="2" name="STATE_CODE" nullable="true" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="10" name="ZIP_CODE" nullable="true" type="id_String" usefulColumn="true"/>
    </metadata>
  </node>
  <node componentName="tMap" componentVersion="2.1" offsetLabelX="0" offsetLabelY="0" posX="320" posY="96">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMap_1" show="false"/>
    <elementParameter field="EXTERNAL" name="MAP" value=""/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="standardized_output">
      <column comment="" key="true" length="12" name="CUSTOMER_ID" nullable="false" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="100" name="ADDRESS_LINE1" nullable="true" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="100" name="ADDRESS_LINE2" nullable="true" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="50" name="CITY" nullable="true" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="2" name="STATE_CODE" nullable="true" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="5" name="ZIP5" nullable="true" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="4" name="ZIP4" nullable="true" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="19" name="STANDARDIZED_AT" nullable="false" pattern="&quot;yyyy-MM-dd HH:mm:ss&quot;" type="id_Date" usefulColumn="true"/>
    </metadata>
    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties shellMaximized="true"/>
      <varTables sizeState="INTERMEDIATE" name="Var" minimized="false">
        <mapperTableEntries name="normalizedAddr" expression="row1.ADDRESS_LINE1 != null ? StringHandling.UPCASE(row1.ADDRESS_LINE1.trim()).replaceAll(&quot;\bSTREET\b&quot;, &quot;ST&quot;).replaceAll(&quot;\bAVENUE\b&quot;, &quot;AVE&quot;).replaceAll(&quot;\bBOULEVARD\b&quot;, &quot;BLVD&quot;).replaceAll(&quot;\bDRIVE\b&quot;, &quot;DR&quot;).replaceAll(&quot;\bAPARTMENT\b&quot;, &quot;APT&quot;).replaceAll(&quot;\bSUITE\b&quot;, &quot;STE&quot;) : null" type="id_String" nullable="true"/>
        <mapperTableEntries name="zip5" expression="row1.ZIP_CODE != null &amp;&amp; row1.ZIP_CODE.length() >= 5 ? row1.ZIP_CODE.substring(0, 5) : row1.ZIP_CODE" type="id_String" nullable="true"/>
        <mapperTableEntries name="zip4" expression="row1.ZIP_CODE != null &amp;&amp; row1.ZIP_CODE.contains(&quot;-&quot;) &amp;&amp; row1.ZIP_CODE.length() >= 10 ? row1.ZIP_CODE.substring(6) : null" type="id_String" nullable="true"/>
      </varTables>
      <outputTables sizeState="INTERMEDIATE" name="standardized_output">
        <mapperTableEntries name="CUSTOMER_ID" expression="row1.CUSTOMER_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="ADDRESS_LINE1" expression="Var.normalizedAddr" type="id_String" nullable="true"/>
        <mapperTableEntries name="ADDRESS_LINE2" expression="row1.ADDRESS_LINE2 != null ? StringHandling.UPCASE(row1.ADDRESS_LINE2.trim()) : null" type="id_String" nullable="true"/>
        <mapperTableEntries name="CITY" expression="row1.CITY != null ? StringHandling.UPCASE(row1.CITY.trim()) : null" type="id_String" nullable="true"/>
        <mapperTableEntries name="STATE_CODE" expression="row1.STATE_CODE != null ? row1.STATE_CODE.toUpperCase().trim() : null" type="id_String" nullable="true"/>
        <mapperTableEntries name="ZIP5" expression="Var.zip5" type="id_String" nullable="true"/>
        <mapperTableEntries name="ZIP4" expression="Var.zip4" type="id_String" nullable="true"/>
        <mapperTableEntries name="STANDARDIZED_AT" expression="TalendDate.getCurrentDate()" type="id_Date" nullable="false"/>
      </outputTables>
      <inputTables sizeState="INTERMEDIATE" name="row1" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="CUSTOMER_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="ADDRESS_LINE1" type="id_String" nullable="true"/>
        <mapperTableEntries name="ADDRESS_LINE2" type="id_String" nullable="true"/>
        <mapperTableEntries name="CITY" type="id_String" nullable="true"/>
        <mapperTableEntries name="STATE_CODE" type="id_String" nullable="true"/>
        <mapperTableEntries name="ZIP_CODE" type="id_String" nullable="true"/>
      </inputTables>
    </nodeData>
  </node>
  <node componentName="tDBOutput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="544" posY="96">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBOutput_1" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="SNOWFLAKE"/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;STG_ADDRESS_STANDARDIZED&quot;"/>
    <elementParameter field="CLOSED_LIST" name="DATA_ACTION" value="INSERT_OR_UPDATE"/>
    <elementParameter field="TEXT" name="LABEL" value="&quot;Standardized Addresses&quot;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <connection connectorName="FLOW" label="row1" lineStyle="0" metaname="tFileInputDelimited_1" offsetLabelX="0" offsetLabelY="0" source="tFileInputDelimited_1" target="tMap_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="row1" show="false"/>
  </connection>
  <connection connectorName="FLOW" label="standardized_output" lineStyle="0" metaname="standardized_output" offsetLabelX="0" offsetLabelY="0" source="tMap_1" target="tDBOutput_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="standardized_output" show="false"/>
  </connection>
  <subjob>
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tFileInputDelimited_1" show="false"/>
    <elementParameter field="COLOR" name="SUBJOB_TITLE_COLOR" value="92;131;150" show="false"/>
    <elementParameter field="COLOR" name="SUBJOB_COLOR" value="207;226;236"/>
  </subjob>
</talendfile:ProcessType>
