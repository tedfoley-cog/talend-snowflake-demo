<?xml version="1.0" encoding="UTF-8"?>
<talendfile:ProcessType xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:TalendMapper="http://www.talend.org/mapper" xmlns:talendfile="platform:/resource/org.talend.model/model/TalendFile.xsd" defaultContext="Default" jobType="Standard">
  <context confirmationNeeded="false" name="Default">
    <contextParameter comment="Input file directory" name="input_dir" prompt="input_dir?" promptNeeded="false" type="id_String" value="/data/incoming/loan_apps/"/>
    <contextParameter comment="Archive directory" name="archive_dir" prompt="archive_dir?" promptNeeded="false" type="id_String" value="/data/archive/loan_apps/"/>
    <contextParameter comment="Target database schema" name="tgt_schema" prompt="tgt_schema?" promptNeeded="false" type="id_String" value="RAW"/>
  </context>
  <parameters>
    <elementParameter field="TEXT" name="SCREEN_OFFSET_X" value="0" show="false"/>
    <elementParameter field="TEXT" name="SCREEN_OFFSET_Y" value="0" show="false"/>
    <elementParameter field="CHECK" name="MULTI_THREAD_EXECATION" value="false"/>
    <elementParameter field="CHECK" name="STATANDLOG_USE_PROJECT_SETTINGS" value="true" show="false"/>
    <routinesParameter id="_lA1aBcDeFg" name="DataOperation"/>
    <routinesParameter id="_lA2aBcDeFg" name="Numeric"/>
    <routinesParameter id="_lA3aBcDeFg" name="TalendDate"/>
    <routinesParameter id="_lA4aBcDeFg" name="AmountUtils"/>
  </parameters>
  <node componentName="tFileInputDelimited" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="96" posY="96">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tFileInputDelimited_1" show="false"/>
    <elementParameter field="FILE" name="FILENAME" value="context.input_dir + &quot;daily_loan_applications.csv&quot;"/>
    <elementParameter field="TEXT" name="ROWSEPARATOR" value="&quot;\n&quot;"/>
    <elementParameter field="TEXT" name="FIELDSEPARATOR" value="&quot;,&quot;"/>
    <elementParameter field="CHECK" name="CSV_OPTION" value="true"/>
    <elementParameter field="TEXT" name="ESCAPE_CHAR" value="&quot;\&quot;&quot;"/>
    <elementParameter field="TEXT" name="TEXT_ENCLOSURE" value="&quot;\&quot;&quot;"/>
    <elementParameter field="TEXT" name="HEADER" value="1"/>
    <elementParameter field="TEXT" name="FOOTER" value="0"/>
    <elementParameter field="TEXT" name="LIMIT" value=""/>
    <elementParameter field="ENCODING_TYPE" name="ENCODING" value="&quot;UTF-8&quot;"/>
    <elementParameter field="CHECK" name="SPLITRECORD" value="false"/>
    <elementParameter field="CHECK" name="REMOVE_EMPTY_ROW" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="&quot;Daily Loan Apps CSV&quot;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tFileInputDelimited_1">
      <column comment="" key="true" length="20" name="APPLICATION_ID" nullable="false" sourceType="" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="12" name="CUSTOMER_ID" nullable="false" sourceType="" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="20" name="LOAN_TYPE" nullable="false" sourceType="" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="15" name="REQUESTED_AMOUNT" nullable="false" sourceType="" type="id_Double" usefulColumn="true"/>
      <column comment="" key="false" length="5" name="TERM_MONTHS" nullable="false" sourceType="" type="id_Integer" usefulColumn="true"/>
      <column comment="" key="false" length="6" name="INTEREST_RATE" nullable="true" sourceType="" type="id_Double" usefulColumn="true"/>
      <column comment="" key="false" length="20" name="COLLATERAL_TYPE" nullable="true" sourceType="" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="15" name="COLLATERAL_VALUE" nullable="true" sourceType="" type="id_Double" usefulColumn="true"/>
      <column comment="" key="false" length="15" name="ANNUAL_INCOME" nullable="false" sourceType="" type="id_Double" usefulColumn="true"/>
      <column comment="" key="false" length="5" name="CREDIT_SCORE" nullable="false" sourceType="" type="id_Integer" usefulColumn="true"/>
      <column comment="" key="false" length="10" name="APPLICATION_DATE" nullable="false" pattern="&quot;yyyy-MM-dd&quot;" sourceType="" type="id_Date" usefulColumn="true"/>
      <column comment="" key="false" length="10" name="STATUS" nullable="false" sourceType="" type="id_String" usefulColumn="true"/>
    </metadata>
  </node>
  <node componentName="tMap" componentVersion="2.1" offsetLabelX="0" offsetLabelY="0" posX="320" posY="96">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMap_1" show="false"/>
    <elementParameter field="EXTERNAL" name="MAP" value=""/>
    <elementParameter field="TEXT" name="ROWS_BUFFER_SIZE" value="2000000"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="loan_output">
      <column comment="" key="true" length="20" name="APPLICATION_ID" nullable="false" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="12" name="CUSTOMER_ID" nullable="false" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="20" name="LOAN_TYPE" nullable="false" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="15" name="REQUESTED_AMOUNT" nullable="false" type="id_Double" usefulColumn="true"/>
      <column comment="" key="false" length="15" name="FORMATTED_AMOUNT" nullable="false" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="5" name="TERM_MONTHS" nullable="false" type="id_Integer" usefulColumn="true"/>
      <column comment="" key="false" length="6" name="INTEREST_RATE" nullable="true" type="id_Double" usefulColumn="true"/>
      <column comment="" key="false" length="10" name="DTI_RATIO" nullable="false" type="id_Double" usefulColumn="true"/>
      <column comment="" key="false" length="10" name="LTV_RATIO" nullable="true" type="id_Double" usefulColumn="true"/>
      <column comment="" key="false" length="10" name="APPLICATION_DATE" nullable="false" pattern="&quot;yyyy-MM-dd&quot;" type="id_Date" usefulColumn="true"/>
      <column comment="" key="false" length="19" name="INGESTED_AT" nullable="false" pattern="&quot;yyyy-MM-dd HH:mm:ss&quot;" type="id_Date" usefulColumn="true"/>
    </metadata>
    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties shellMaximized="true"/>
      <varTables sizeState="INTERMEDIATE" name="Var" minimized="false">
        <mapperTableEntries name="monthlyPayment" expression="AmountUtils.calculateMonthlyPayment(row1.REQUESTED_AMOUNT, row1.INTEREST_RATE, row1.TERM_MONTHS)" type="id_Double" nullable="false"/>
        <mapperTableEntries name="dtiRatio" expression="row1.ANNUAL_INCOME > 0 ? (Var.monthlyPayment * 12) / row1.ANNUAL_INCOME : 0" type="id_Double" nullable="false"/>
        <mapperTableEntries name="ltvRatio" expression="row1.COLLATERAL_VALUE != null &amp;&amp; row1.COLLATERAL_VALUE > 0 ? row1.REQUESTED_AMOUNT / row1.COLLATERAL_VALUE : null" type="id_Double" nullable="true"/>
      </varTables>
      <outputTables sizeState="INTERMEDIATE" name="loan_output">
        <mapperTableEntries name="APPLICATION_ID" expression="row1.APPLICATION_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="CUSTOMER_ID" expression="row1.CUSTOMER_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="LOAN_TYPE" expression="row1.LOAN_TYPE.toUpperCase().trim()" type="id_String" nullable="false"/>
        <mapperTableEntries name="REQUESTED_AMOUNT" expression="row1.REQUESTED_AMOUNT" type="id_Double" nullable="false"/>
        <mapperTableEntries name="FORMATTED_AMOUNT" expression="AmountUtils.formatCurrency(row1.REQUESTED_AMOUNT)" type="id_String" nullable="false"/>
        <mapperTableEntries name="TERM_MONTHS" expression="row1.TERM_MONTHS" type="id_Integer" nullable="false"/>
        <mapperTableEntries name="INTEREST_RATE" expression="row1.INTEREST_RATE" type="id_Double" nullable="true"/>
        <mapperTableEntries name="DTI_RATIO" expression="AmountUtils.roundToDecimal(Var.dtiRatio, 4)" type="id_Double" nullable="false"/>
        <mapperTableEntries name="LTV_RATIO" expression="Var.ltvRatio != null ? AmountUtils.roundToDecimal(Var.ltvRatio, 4) : null" type="id_Double" nullable="true"/>
        <mapperTableEntries name="APPLICATION_DATE" expression="row1.APPLICATION_DATE" type="id_Date" nullable="false"/>
        <mapperTableEntries name="INGESTED_AT" expression="TalendDate.getCurrentDate()" type="id_Date" nullable="false"/>
      </outputTables>
      <inputTables sizeState="INTERMEDIATE" name="row1" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="APPLICATION_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="CUSTOMER_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="LOAN_TYPE" type="id_String" nullable="false"/>
        <mapperTableEntries name="REQUESTED_AMOUNT" type="id_Double" nullable="false"/>
        <mapperTableEntries name="TERM_MONTHS" type="id_Integer" nullable="false"/>
        <mapperTableEntries name="INTEREST_RATE" type="id_Double" nullable="true"/>
        <mapperTableEntries name="COLLATERAL_TYPE" type="id_String" nullable="true"/>
        <mapperTableEntries name="COLLATERAL_VALUE" type="id_Double" nullable="true"/>
        <mapperTableEntries name="ANNUAL_INCOME" type="id_Double" nullable="false"/>
        <mapperTableEntries name="CREDIT_SCORE" type="id_Integer" nullable="false"/>
        <mapperTableEntries name="APPLICATION_DATE" type="id_Date" nullable="false"/>
        <mapperTableEntries name="STATUS" type="id_String" nullable="false"/>
      </inputTables>
    </nodeData>
  </node>
  <node componentName="tDBOutput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="544" posY="96">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBOutput_1" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="SNOWFLAKE"/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;STG_LOAN_APPLICATION&quot;"/>
    <elementParameter field="CLOSED_LIST" name="DATA_ACTION" value="INSERT"/>
    <elementParameter field="TEXT" name="LABEL" value="&quot;Load to Snowflake&quot;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <connection connectorName="FLOW" label="row1" lineStyle="0" metaname="tFileInputDelimited_1" offsetLabelX="0" offsetLabelY="0" source="tFileInputDelimited_1" target="tMap_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="row1" show="false"/>
  </connection>
  <connection connectorName="FLOW" label="loan_output" lineStyle="0" metaname="loan_output" offsetLabelX="0" offsetLabelY="0" source="tMap_1" target="tDBOutput_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="loan_output" show="false"/>
  </connection>
  <subjob>
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tFileInputDelimited_1" show="false"/>
    <elementParameter field="COLOR" name="SUBJOB_TITLE_COLOR" value="92;131;150" show="false"/>
    <elementParameter field="COLOR" name="SUBJOB_COLOR" value="207;226;236"/>
  </subjob>
</talendfile:ProcessType>
