<?xml version="1.0" encoding="UTF-8"?>
<talendfile:ProcessType xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:TalendMapper="http://www.talend.org/mapper" xmlns:talendfile="platform:/resource/org.talend.model/model/TalendFile.xsd" defaultContext="Default" jobType="Standard">
  <context confirmationNeeded="false" name="Default">
    <contextParameter comment="Source database host" name="src_db_host" prompt="src_db_host?" promptNeeded="false" type="id_String" value="db-source-prod.internal"/>
    <contextParameter comment="Reconciliation date" name="recon_date" prompt="recon_date?" promptNeeded="false" type="id_String" value=""/>
    <contextParameter comment="Tolerance amount for matching" name="match_tolerance" prompt="match_tolerance?" promptNeeded="false" type="id_Double" value="0.01"/>
  </context>
  <parameters>
    <elementParameter field="TEXT" name="SCREEN_OFFSET_X" value="0" show="false"/>
    <elementParameter field="TEXT" name="SCREEN_OFFSET_Y" value="0" show="false"/>
    <elementParameter field="CHECK" name="MULTI_THREAD_EXECATION" value="false"/>
    <elementParameter field="CHECK" name="STATANDLOG_USE_PROJECT_SETTINGS" value="true" show="false"/>
    <routinesParameter id="_pM1aBcDeFg" name="DataOperation"/>
    <routinesParameter id="_pM2aBcDeFg" name="Numeric"/>
    <routinesParameter id="_pM3aBcDeFg" name="TalendDate"/>
    <routinesParameter id="_pM4aBcDeFg" name="AmountUtils"/>
  </parameters>
  <node componentName="tDBInput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="96" posY="64">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBInput_1" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="ORACLE_12"/>
    <elementParameter field="TEXT" name="HOST" value="context.src_db_host"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT PAYMENT_ID, LOAN_ID, CUSTOMER_ID, PAYMENT_AMOUNT, PAYMENT_DATE, PAYMENT_METHOD, REFERENCE_NUM FROM INCOMING_PAYMENTS WHERE PAYMENT_DATE = TO_DATE(context.recon_date, 'YYYY-MM-DD') AND RECONCILED = 'N'&quot;"/>
    <elementParameter field="TEXT" name="LABEL" value="&quot;Incoming Payments&quot;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tDBInput_1">
      <column comment="" key="true" length="20" name="PAYMENT_ID" nullable="false" sourceType="VARCHAR2" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="20" name="LOAN_ID" nullable="false" sourceType="VARCHAR2" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="12" name="CUSTOMER_ID" nullable="false" sourceType="VARCHAR2" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="15" name="PAYMENT_AMOUNT" nullable="false" sourceType="NUMBER" type="id_Double" usefulColumn="true"/>
      <column comment="" key="false" length="10" name="PAYMENT_DATE" nullable="false" pattern="&quot;yyyy-MM-dd&quot;" sourceType="DATE" type="id_Date" usefulColumn="true"/>
      <column comment="" key="false" length="20" name="PAYMENT_METHOD" nullable="false" sourceType="VARCHAR2" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="30" name="REFERENCE_NUM" nullable="true" sourceType="VARCHAR2" type="id_String" usefulColumn="true"/>
    </metadata>
  </node>
  <node componentName="tDBInput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="96" posY="192">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBInput_2" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="ORACLE_12"/>
    <elementParameter field="TEXT" name="HOST" value="context.src_db_host"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT LOAN_ID, CUSTOMER_ID, OUTSTANDING_BALANCE, MONTHLY_PAYMENT_DUE, DUE_DATE, DAYS_PAST_DUE FROM LOAN_BALANCE WHERE DUE_DATE &lt;= TO_DATE(context.recon_date, 'YYYY-MM-DD')&quot;"/>
    <elementParameter field="TEXT" name="LABEL" value="&quot;Outstanding Balances&quot;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tDBInput_2">
      <column comment="" key="true" length="20" name="LOAN_ID" nullable="false" sourceType="VARCHAR2" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="12" name="CUSTOMER_ID" nullable="false" sourceType="VARCHAR2" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="15" name="OUTSTANDING_BALANCE" nullable="false" sourceType="NUMBER" type="id_Double" usefulColumn="true"/>
      <column comment="" key="false" length="15" name="MONTHLY_PAYMENT_DUE" nullable="false" sourceType="NUMBER" type="id_Double" usefulColumn="true"/>
      <column comment="" key="false" length="10" name="DUE_DATE" nullable="false" pattern="&quot;yyyy-MM-dd&quot;" sourceType="DATE" type="id_Date" usefulColumn="true"/>
      <column comment="" key="false" length="5" name="DAYS_PAST_DUE" nullable="false" sourceType="NUMBER" type="id_Integer" usefulColumn="true"/>
    </metadata>
  </node>
  <node componentName="tMap" componentVersion="2.1" offsetLabelX="0" offsetLabelY="0" posX="384" posY="96">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMap_1" show="false"/>
    <elementParameter field="EXTERNAL" name="MAP" value=""/>
    <elementParameter field="TEXT" name="ROWS_BUFFER_SIZE" value="2000000"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="matched_payments">
      <column comment="" key="true" length="20" name="PAYMENT_ID" nullable="false" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="20" name="LOAN_ID" nullable="false" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="12" name="CUSTOMER_ID" nullable="false" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="15" name="PAYMENT_AMOUNT" nullable="false" type="id_Double" usefulColumn="true"/>
      <column comment="" key="false" length="15" name="AMOUNT_DUE" nullable="false" type="id_Double" usefulColumn="true"/>
      <column comment="" key="false" length="15" name="VARIANCE" nullable="false" type="id_Double" usefulColumn="true"/>
      <column comment="" key="false" length="15" name="MATCH_STATUS" nullable="false" type="id_String" usefulColumn="true"/>
      <column comment="" key="false" length="19" name="RECONCILED_AT" nullable="false" pattern="&quot;yyyy-MM-dd HH:mm:ss&quot;" type="id_Date" usefulColumn="true"/>
    </metadata>
    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties shellMaximized="true"/>
      <varTables sizeState="INTERMEDIATE" name="Var" minimized="false">
        <mapperTableEntries name="variance" expression="Math.abs(row1.PAYMENT_AMOUNT - row2.MONTHLY_PAYMENT_DUE)" type="id_Double" nullable="false"/>
        <mapperTableEntries name="isExactMatch" expression="Var.variance &lt;= context.match_tolerance" type="id_Boolean" nullable="false"/>
        <mapperTableEntries name="isOverpayment" expression="row1.PAYMENT_AMOUNT > row2.MONTHLY_PAYMENT_DUE + context.match_tolerance" type="id_Boolean" nullable="false"/>
        <mapperTableEntries name="isUnderpayment" expression="row1.PAYMENT_AMOUNT &lt; row2.MONTHLY_PAYMENT_DUE - context.match_tolerance" type="id_Boolean" nullable="false"/>
      </varTables>
      <outputTables sizeState="INTERMEDIATE" name="matched_payments">
        <mapperTableEntries name="PAYMENT_ID" expression="row1.PAYMENT_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="LOAN_ID" expression="row1.LOAN_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="CUSTOMER_ID" expression="row1.CUSTOMER_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="PAYMENT_AMOUNT" expression="AmountUtils.roundToDecimal(row1.PAYMENT_AMOUNT, 2)" type="id_Double" nullable="false"/>
        <mapperTableEntries name="AMOUNT_DUE" expression="AmountUtils.roundToDecimal(row2.MONTHLY_PAYMENT_DUE, 2)" type="id_Double" nullable="false"/>
        <mapperTableEntries name="VARIANCE" expression="AmountUtils.roundToDecimal(Var.variance, 2)" type="id_Double" nullable="false"/>
        <mapperTableEntries name="MATCH_STATUS" expression="Var.isExactMatch ? &quot;MATCHED&quot; : (Var.isOverpayment ? &quot;OVERPAYMENT&quot; : &quot;UNDERPAYMENT&quot;)" type="id_String" nullable="false"/>
        <mapperTableEntries name="RECONCILED_AT" expression="TalendDate.getCurrentDate()" type="id_Date" nullable="false"/>
      </outputTables>
      <inputTables sizeState="INTERMEDIATE" name="row1" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="PAYMENT_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="LOAN_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="CUSTOMER_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="PAYMENT_AMOUNT" type="id_Double" nullable="false"/>
        <mapperTableEntries name="PAYMENT_DATE" type="id_Date" nullable="false"/>
        <mapperTableEntries name="PAYMENT_METHOD" type="id_String" nullable="false"/>
        <mapperTableEntries name="REFERENCE_NUM" type="id_String" nullable="true"/>
      </inputTables>
      <inputTables sizeState="INTERMEDIATE" name="row2" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE" joinModel="LEFT_OUTER_JOIN" joinExpressionKey="row1.LOAN_ID" joinExpression="row2.LOAN_ID">
        <mapperTableEntries name="LOAN_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="CUSTOMER_ID" type="id_String" nullable="false"/>
        <mapperTableEntries name="OUTSTANDING_BALANCE" type="id_Double" nullable="false"/>
        <mapperTableEntries name="MONTHLY_PAYMENT_DUE" type="id_Double" nullable="false"/>
        <mapperTableEntries name="DUE_DATE" type="id_Date" nullable="false"/>
        <mapperTableEntries name="DAYS_PAST_DUE" type="id_Integer" nullable="false"/>
      </inputTables>
    </nodeData>
  </node>
  <node componentName="tDBOutput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="608" posY="96">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBOutput_1" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="SNOWFLAKE"/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;PAYMENT_RECONCILIATION&quot;"/>
    <elementParameter field="CLOSED_LIST" name="DATA_ACTION" value="INSERT"/>
    <elementParameter field="TEXT" name="LABEL" value="&quot;Reconciliation Results&quot;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <connection connectorName="FLOW" label="row1" lineStyle="0" metaname="tDBInput_1" offsetLabelX="0" offsetLabelY="0" source="tDBInput_1" target="tMap_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="row1" show="false"/>
  </connection>
  <connection connectorName="FLOW" label="row2" lineStyle="0" metaname="tDBInput_2" offsetLabelX="0" offsetLabelY="0" source="tDBInput_2" target="tMap_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="row2" show="false"/>
  </connection>
  <connection connectorName="FLOW" label="matched_payments" lineStyle="0" metaname="matched_payments" offsetLabelX="0" offsetLabelY="0" source="tMap_1" target="tDBOutput_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="matched_payments" show="false"/>
  </connection>
  <subjob>
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBInput_1" show="false"/>
    <elementParameter field="COLOR" name="SUBJOB_TITLE_COLOR" value="92;131;150" show="false"/>
    <elementParameter field="COLOR" name="SUBJOB_COLOR" value="207;226;236"/>
  </subjob>
</talendfile:ProcessType>
